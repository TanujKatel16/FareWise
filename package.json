{
  "name": "farewise",
  "version": "2.0.0",
  "private": true,
  "description": "Location-aware fare estimates and local place discovery for travelers",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed-mongodb.cjs",
    "build:seed": "node scripts/build-seed.cjs",
    "format": "prettier --write \"**/*.{js,cjs,json,html,css,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,json,html,css,md,yml}\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
