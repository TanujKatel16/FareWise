PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=farewise
# Optional: enables ChatGPT explanations. Pricing remains deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: Google Places API (New). Keep the key server-side in .env; never expose it in browser code.
GOOGLE_MAPS_API_KEY=
